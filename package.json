{
  "name": "pi-handoff-chain",
  "version": "1.3.0",
  "description": "Kill & Handoff protocol for pi — per-task handoff lanes, checkpointed context resets, in-chat briefs, watermark-enforced landing, and fresh-session task chaining with model choice",
  "keywords": [
    "pi-package",
    "pi-extension",
    "multi-agent",
    "handoff",
    "context-management",
    "context-reset",
    "orchestration",
    "lanes"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "scripts",
    "tsconfig.check.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "./scripts/typecheck.sh",
    "smoke": "node --no-warnings --experimental-strip-types scripts/smoke.mjs",
    "check": "npm run typecheck && npm run smoke",
    "prepublishOnly": "./scripts/typecheck.sh && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martintsan/pi-handoff-chain.git"
  },
  "homepage": "https://github.com/martintsan/pi-handoff-chain#readme",
  "bugs": "https://github.com/martintsan/pi-handoff-chain/issues",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
